{
  "name": "ai-career-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc -p .",
    "watch": "tsc -w --preserveWatchOutput",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "pipeline:run": "tsx src/scripts/run-pipeline.ts",
    "test:sources:live": "tsx src/scripts/test-all-sources.ts",
    "db:prune": "tsx src/scripts/db-prune.ts",
    "test:load": "vitest run tests/load",
    "test:load:10k": "tsx src/scripts/load-test-10k.ts",
    "test:chaos": "vitest run tests/load/chaos-recovery.test.ts",
    "test:chaos:run": "tsx src/scripts/chaos-test.ts",
    "db:migrate:v1:dry-run": "tsx src/scripts/migrate-v1-to-v2.ts --dry-run",
    "db:migrate:v1": "tsx src/scripts/migrate-v1-to-v2.ts --commit",
    "db:migrate:v1:reconcile": "tsx src/scripts/migrate-v1-to-v2.ts --reconcile",
    "deploy:check": "tsx src/scripts/production-cutover-check.ts",
    "ops:rollback:check": "tsx src/scripts/rollback-v2.ts --check",
    "ops:emergency-pause": "tsx src/scripts/rollback-v2.ts --emergency-pause",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/sources tests/deduplication tests/matching tests/telegram tests/services",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --reporter=verbose",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prisma": "^6.4.1",
    "tsx": "^4.20.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@neon/config": "^1.14.5",
    "@neon/env": "^2.1.8",
    "@prisma/client": "^6.4.1",
    "@types/cheerio": "^0.22.35",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/luxon": "^3.7.5",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.13.3",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "grammy": "^1.46.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^6.0.0",
    "luxon": "^3.7.2",
    "ms": "^2.1.3",
    "redis": "^6.2.1",
    "typescript": "^5.9.2",
    "zod": "^3.24.2"
  }
}
